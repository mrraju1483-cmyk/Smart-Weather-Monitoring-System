# Copy this file to .env and adjust values for your setup.
SECRET_KEY=replace-with-a-random-local-value
SERIAL_PORT=COM3
SERIAL_BAUD_RATE=9600
SERIAL_RETRY_SECONDS=5
WEATHER_TIMEOUT_SECONDS=8
# Optional. By default the database is stored in data\environment.db.
# DATABASE_PATH=C:\path\to\environment.db
